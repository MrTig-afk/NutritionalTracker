 "info": {
  "description": "Public API v1. Auth: `Authorization: Bearer nsk_live_...` (a personal access token) or an app login. Errors: RFC 9457 application/problem+json with `error_type`. Writes: `?preview=true` first, then the real write with an `Idempotency-Key` (POST) or `If-Match` (PATCH/DELETE).",
  "title": "NutriScan API",
  "version": "1"
 },
 "openapi": "3.1.0",
